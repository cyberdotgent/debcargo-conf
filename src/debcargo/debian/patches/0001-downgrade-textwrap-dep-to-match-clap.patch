From 6cf9f98de6bf653d86f22e0d30d7214aba9986bc Mon Sep 17 00:00:00 2001
From: Ximin Luo <infinity0@debian.org>
Date: Thu, 11 Nov 2021 13:45:36 +0000
Subject: [PATCH 1/3] downgrade textwrap dep to match clap
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

switch to clap 3

cargo 0.63 already uses it, so complete the migration in debcargo now as
well.

there are a few deprecated parts that could be upgraded as well, but
those require more changes.

Signed-off-by: Fabian Grünbichler <f.gruenbichler@proxmox.com>
---
 Cargo.toml          |  7 ++++---
 src/bin/debcargo.rs | 10 ++++++++--
 src/build_order.rs  |  2 +-
 src/package.rs      |  3 ++-
 4 files changed, 15 insertions(+), 7 deletions(-)

Index: debcargo/Cargo.toml
===================================================================
--- debcargo.orig/Cargo.toml
+++ debcargo/Cargo.toml
@@ -25,7 +25,11 @@ version = "0.12"
 version = "1.0"
 
 [dependencies.cargo]
-version = "0.57"
+version = "0.63"
+
+[dependencies.clap]
+version = "3"
+features = ["cargo", "derive"]
 
 [dependencies.chrono]
 version = "0.4"
@@ -63,10 +67,6 @@ version = "1"
 [dependencies.serde_derive]
 version = "1"
 
-[dependencies.structopt]
-version = "0.3"
-features = ["color"]
-
 [dependencies.tar]
 version = "0.4"
 
@@ -74,7 +74,7 @@ version = "0.4"
 version = "3"
 
 [dependencies.textwrap]
-version = "0.14"
+version = "0.15"
 
 [dependencies.toml]
 version = "0.5"
Index: debcargo/src/bin/debcargo.rs
===================================================================
--- debcargo.orig/src/bin/debcargo.rs
+++ debcargo/src/bin/debcargo.rs
@@ -1,6 +1,6 @@
 use ansi_term::Colour::Red;
-use structopt::{
-    clap::{crate_version, AppSettings},
+use clap::{
+    crate_version, AppSettings,
     StructOpt,
 };
 
@@ -48,6 +48,12 @@ enum Opt {
     },
 }
 
+#[test]
+fn verify_app() {
+    use clap::IntoApp;
+    Opt::into_app().debug_assert()
+}
+
 fn real_main() -> Result<()> {
     let m = Opt::clap()
         .global_setting(AppSettings::ColoredHelp)
Index: debcargo/src/build_order.rs
===================================================================
--- debcargo.orig/src/build_order.rs
+++ debcargo/src/build_order.rs
@@ -4,7 +4,7 @@ use std::path::{Path, PathBuf};
 
 use anyhow::Context;
 use cargo::core::{Dependency, PackageId};
-use structopt::{clap::arg_enum, StructOpt};
+use clap::{arg_enum, StructOpt};
 
 use crate::config::Config;
 use crate::crates::{crate_name_ver_to_dep, show_dep, transitive_deps, CrateDepInfo, CrateInfo};
Index: debcargo/src/package.rs
===================================================================
--- debcargo.orig/src/package.rs
+++ debcargo/src/package.rs
@@ -1,7 +1,8 @@
 use std::path::PathBuf;
 
 use anyhow::Context;
-use structopt::{clap::crate_version, StructOpt};
+
+use clap::{crate_version, StructOpt};
 
 use crate::config::Config;
 use crate::crates::CrateInfo;
